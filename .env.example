# Kopieren nach .env und die drei Pflichtwerte setzen.
# Zufallswerte erzeugen:  openssl rand -hex 32

# --- Pflicht ------------------------------------------------------------------
# Verschlüsselt auch die gespeicherten IMAP-Passwörter. Nachträglich ändern
# bedeutet: Passwörter der Postfächer neu eingeben.
SECRET_KEY=
POSTGRES_PASSWORD=
# Wird nur beim allerersten Start für das Admin-Konto verwendet.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional: E-Mail-Adresse des Admin-Kontos beim allerersten Start.
# ADMIN_EMAIL=admin@example.de

# --- NAS ----------------------------------------------------------------------
# Benutzer, dem die Dateien gehören (auf dem NAS per `id <name>` nachsehen).
# Synology: meist 1026 / 100, QNAP: meist 1000 / 100.
PUID=1000
PGID=1000
PORT=8002

# Speicherorte auf dem NAS. Absolute Pfade sind möglich, z. B. /volume1/documan-vaadin/data
DATA_DIR=./data
DB_DIR=./data/postgres
# Hierhin legt der Scanner die Dateien ab (per SMB/NFS freigeben).
CONSUME_DIR=./consume
# Zielordner der Datensicherung. Der Ordner muss bereits existieren. Am besten ein
# anderes Laufwerk, z. B. /volumeUSB1/usbshare/documan oder eine zweite Freigabe.
BACKUP_DIR=./backup
# Nur Synology mit nas-paket/compose.yaml: Dieser Ordner erscheint in der Auswahl des Zielordners
# unter „nas“. Standard ist /volume1, für USB z. B. /volumeUSB1/usbshare. Er muss existieren.
# BACKUP_BROWSE_DIR=/volume1

# --- E-Mail -------------------------------------------------------------------
# Adresse des Systems für Nachrichten. Ohne Angabe gilt die Adresse der aktuellen Anfrage.
# SITE_URL=http://nas.fritz.box:8002
# Erlaubt, auf der Anmeldeseite selbst ein Konto anzulegen. Braucht den SMTP-Server unten.
# Vorsicht: Jedes bestätigte Konto liest das ganze Archiv. Nur einschalten, wenn die Seite
# nicht offen im Internet steht.
# REGISTRATION_ENABLED=true
# Uhrzeit der täglichen Übersicht an alle Superuser, braucht den Mailversand. Leer schaltet sie ab.
# DAILY_REPORT_TIME=07:00
# SMTP-Server. Leer bedeutet: DocuMan verschickt keine E-Mails.
EMAIL_HOST=
EMAIL_PORT=587
# starttls, ssl oder none
EMAIL_SECURITY=starttls
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
# Nur für Postfächer bei Microsoft (Outlook, Hotmail, Microsoft 365): Client-ID der eigenen
# App-Registrierung, die Schritte stehen in der Anleitung unter „E-Mail“.
# MICROSOFT_CLIENT_ID=
# common = private und geschäftliche Konten, consumers = nur private, oder die ID Ihres Mandanten.
# MICROSOFT_TENANT=common

# --- Optional -----------------------------------------------------------------
# Tesseract-Kürzel. Andere Sprachen zusätzlich im Dockerfile einbauen.
OCR_LANGUAGES=deu+eng
# CPU-Kerne je Dokument. Auf kleinen NAS bei 1 lassen.
OCR_JOBS=1
# pdfa = langzeitarchivfest, pdf = deutlich schneller
OCR_OUTPUT_TYPE=pdfa
OCR_TIMEOUT_SECONDS=3600

CONSUME_POLL_SECONDS=10
CONSUME_STABLE_SECONDS=10
MAX_FILE_MB=500

# Arbeitsspeicher der Java-Prozesse in MB.
WEB_HEAP_MB=256
WORKER_HEAP_MB=512

# Kommagetrennt. Nur nötig, wenn DocuMan nicht jeden Hostnamen akzeptieren soll.
ALLOWED_HOSTS=*
# Hinter einem Reverse Proxy mit HTTPS:
# HTTPS=true
TIME_ZONE=Europe/Berlin
